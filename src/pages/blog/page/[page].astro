---
import PostPreview from '@/components/post/PostPreview.astro';
import NoData from '@/components/NoData.astro';
import PageToggle from '@/components/PageToggle.astro';
import SiteBase from '@/layouts/SiteBase.astro';
import MoreTags from '@/components/MoreTags.astro';
import type { GetStaticPaths } from 'astro';
import { getOrderedBlogPosts, getMoreTags } from '@/utils/blog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getOrderedBlogPosts();

  return paginate(allPostsByDate, {
    pageSize: 10,
  });
};

import type { BlogListPageProps } from '@/types/pages.types';

const { page } = Astro.props as unknown as BlogListPageProps;

const tags = await getMoreTags();

const canonicalURL = page.url.current.endsWith('/page/1')
  ? new URL('/blog/', Astro.site)
  : undefined;
---

<SiteBase title="Blog" canonicalUrl={canonicalURL}>
  { page.data.length > 0 ? (
    <div class='relative'>
      <section class={ `${page.url.prev ? 'mb-10' : '' }` } >
        <h1 class="text-2xl font-bold">Posts</h1>
        <div>
          {page.data.map((post) => <PostPreview post={post} />)}
        </div>
      </section>
      <PageToggle page={ page } />
      {tags.length > 0 && (
        <hr class="opacity-30 my-5 lg:hidden"/>
        <MoreTags tags={tags} />
      )}
    </div>
  ) : (
    <NoData />
  )}
</SiteBase>
