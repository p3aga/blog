---
import NoData from '@/components/NoData.astro';
import SiteBase from '@/layouts/SiteBase.astro';
import { getTagsWithCountPostsByTag } from '@/utils/blog';

const tags = await getTagsWithCountPostsByTag();
---

<SiteBase title="Tags">
  { tags.length > 0 ? (
    <section>
      <h1 class="text-2xl font-bold mb-5">Tags</h1>
      {tags.map(tag => ( 
        <div class="mb-1">
          <a href={`${import.meta.env.BASE_URL}tags/${tag.name}/`}>
            <b class="font-serif italic font-semibold">#{tag.name}</b>
            <span class="opacity-50 text-xs">{tag.postCount} posts</span>
          </a>
        </div>
      ))}
    </section>
  ) : (
    <NoData />
  )}
</SiteBase>