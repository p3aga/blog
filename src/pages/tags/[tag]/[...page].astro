---
import type { GetStaticPaths } from 'astro';
import NoData from '@/components/NoData.astro';
import PageToggle from '@/components/PageToggle.astro';
import PostPreview from '@/components/post/PostPreview.astro';
import SiteBase from '@/layouts/SiteBase.astro';
import type { TagsListPageProps } from '@/types/pages.types';
import { getAllTags, getOrderedBlogPosts } from '@/utils/blog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getOrderedBlogPosts();
  const allTags = await getAllTags();

  return allTags.flatMap((tag) => {
    const postsByTag = allPostsByDate.filter((post) =>
      post.data.tags?.includes(tag),
    );

    return paginate(postsByTag, {
      pageSize: 10,
      params: { tag },
    });
  });
};

const { page } = Astro.props as unknown as TagsListPageProps;
const { tag } = Astro.params;
---

<SiteBase title="Projetos">
  { page.data.length > 0 ? (
    <section class={ `${page.url.prev && 'mb-10'}` }>
      <h1 class="text-2xl font-bold">Tag: {tag}</h1>
      <div>
        {page.data.map((post) => <PostPreview post={post} />)}
      </div>
    </section>
    <PageToggle page={ page } />
  ) : (
    <NoData />
  )}
</SiteBase>