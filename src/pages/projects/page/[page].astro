---
import type { GetStaticPaths } from 'astro';
import PostPreview from '@/components/post/PostPreview.astro';
import NoData from '@/components/NoData.astro';
import PageToggle from '@/components/PageToggle.astro';
import SiteBase from '@/layouts/SiteBase.astro';
import { getOrderedProjectPosts } from '@/utils/projects';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getOrderedProjectPosts();

  return paginate(allPostsByDate, {
    pageSize: 10,
  });
};

import type { ProjectsListPageProps } from '@/types/pages.types';

const { page } = Astro.props as unknown as ProjectsListPageProps;

const canonicalURL = page.url.current.endsWith('/page/1')
  ? new URL('/projects/', Astro.site)
  : undefined;
---

<SiteBase title="Projetos" canonicalUrl={canonicalURL}>
  { page.data.length > 0 ? (
    <section class={ `${page.url.prev && 'mb-10'}` }>
      <h1 class="text-2xl font-bold">Projetos</h1>
      <div>
        {page.data.map((post) => <PostPreview post={post} />)}
      </div>
    </section>
    <PageToggle page={ page } />
  ) : (
    <NoData />
  )}
</SiteBase>