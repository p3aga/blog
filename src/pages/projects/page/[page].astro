---
import type { GetStaticPaths, Page } from 'astro';
import PostPreview from '@/components/blog/PostPreview.astro';
import NoData from '@/components/layout/NoData.astro';
import PageToggle from '@/components/layout/PageToggle.astro';
import SiteBase from '@/layouts/SiteBase.astro';
import { getOrderedBlogPosts } from '@/utils/blog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = await getOrderedBlogPosts();

  const projects = allPostsByDate.filter((post) =>
    post.data.tags?.includes('projeto'),
  );

  return paginate(projects, {
    pageSize: 10,
  });
};

import type { BlogListPageProps } from '@/types/pages.types';

const { page } = Astro.props as unknown as BlogListPageProps;
---

<SiteBase title={ `Projetos pág ${page.currentPage}` }>
  { page.data.length > 0 ? (
    <section class={ `${page.url.prev && 'mb-10'}` }>
      <h1 class="text-2xl font-bold">Projetos</h1>
      <div>
        {page.data.map((post) => <PostPreview post={post} />)}
      </div>
    </section>
    <PageToggle page={ page } />
  ) : (
    <NoData />
  )}
</SiteBase>