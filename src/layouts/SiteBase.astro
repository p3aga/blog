---
import BackToTop from '@/components/layout/BackToTop.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Base from '@/layouts/Base.astro';
import type { SiteBaseProps } from '@/types/layouts.types';

const { title, canonicalUrl } = Astro.props as SiteBaseProps;
---

<Base title={title} canonicalUrl={canonicalUrl}>
  <div class="m-auto w-auto px-5 sm:w-xl sm:px-0">
    <Header />
    <main class="mt-15">
      <slot></slot>
    </main>
    <Footer />
    <BackToTop />
  </div>
</Base>
